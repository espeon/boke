---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/utils";

const collection = await getCollection("posts");
const posts = collection
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter((post) => post.data.draft !== true);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="mx-auto flex w-full max-w-[40rem] flex-1 flex-col">
    <ul class="flex flex-col">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/posts/${post.slug}`}
              class="group hover:bg-muted -mx-4 flex flex-col gap-1 rounded-lg px-4 py-3 transition-colors"
            >
              <div class="flex flex-row items-baseline justify-between gap-4">
                <div class="text-accent-foreground font-serif text-lg group-hover:underline">
                  {post.data.title}
                </div>
                <span class="text-muted-foreground text-sm text-nowrap">
                  {formatDate(post.data.date)}
                </span>
              </div>
              <div class="text-muted-foreground">{post.data.description}</div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
