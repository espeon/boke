---
import { LastFM } from "../components/lastfm";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";

import HomeLink from "../components/HomeLink.astro";

import { getCollection } from "astro:content";

const collection = await getCollection("posts");
const posts = collection
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter((post) => post.data.draft !== true);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="mx-auto grid max-w-screen-lg grid-cols-1 gap-6 md:grid-cols-12">
    <div class="typeset col-span-2 flex min-w-full flex-col">
      <div
        class="mt-7.25 flex w-full flex-row items-end justify-between gap-2 md:ml-auto"
      >
        <ThemeSwitcher />
        <p class="font-serif">Natalie B.</p>
      </div>
    </div>
    <div class="col-span-8 min-w-full rounded-lg md:mt-12">
      <div class="typeset">
        <p>is <i>thinking through things</i>.</p>
        <p>
          Building great software and multimedia web experiences, and a big fan
          of open social. <br />Currently at <a
            href="https://stream.place"
            target="_blank"
            rel="noopener noreferrer">Streamplace</a
          >.
        </p>
        <p>
          Previously, I've helped out at the <a
            href="https://atmosphere.community"
            target="_blank"
            rel="noopener noreferrer">Atmosphere Community</a
          > org, and worked on various open-source projects, such as <a
            href="https://teal.fm"
            target="_blank"
            rel="noopener noreferrer">teal.fm</a
          >.
        </p>
      </div>
    </div>
  </div>
  <div
    class="mx-auto mt-8 grid max-w-screen-lg grid-cols-1 gap-6 md:grid-cols-12"
  >
    <div class="col-span-2 flex min-w-full flex-col">
      <div class="flex flex-row items-end gap-2 md:ml-auto">
        <p class="font-serif">Selected works</p>
      </div>
    </div>
    <div class="col-span-8 min-w-full rounded-lg">
      <div class="space-y-2">
        <HomeLink
          href="https://teal.fm"
          text="teal.fm"
          description="Music tracking made for open social. Decentralized, if you prefer."
        />
        <HomeLink
          href="https://github.com/espeon/muse"
          text="Muse"
          description="A self-hosted music streaming service. Focusing on UX that rivals the best, with a focus on speed and efficient audio delivery."
        />
        <HomeLink
          href="https://spwn.run"
          text="spwn.run"
          description="Turn some linux servers into your own developer cloud, with persistent Firecracker microVMs, pooled resources, SSH access, and automatic web routing."
        />
      </div>
    </div>
  </div>
  <div
    class="mx-auto mt-8 grid max-w-screen-lg grid-cols-1 gap-6 md:grid-cols-12"
  >
    <div class="col-span-2 flex min-w-full flex-col">
      <div class="flex flex-row items-end gap-2 md:ml-auto">
        <p class="font-serif">Now</p>
      </div>
    </div>
  </div>
  <div
    class="mx-auto mt-2 grid max-w-screen-lg grid-cols-1 gap-6 md:grid-cols-12"
  >
    <div class="col-span-2 flex min-w-full flex-col">
      <div class="flex flex-row items-end gap-2 md:ml-auto">
        <p class="text-muted-foreground font-serif">Listening</p>
      </div>
    </div>
    <div class="col-span-8 min-w-full rounded-lg">
      <div class="max-w-full">
        <LastFM client:load client:only />
      </div>
    </div>
  </div>
</Layout>
