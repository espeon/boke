---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  className?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, className } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      // Preserve anchor scrolling to margin-note/ref targets across navigation.
      if (
        window.location.hash.startsWith("#note-") ||
        window.location.hash.startsWith("#ref-")
      ) {
        const noteHash = window.location.hash;
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }
        const url = window.location.pathname + window.location.search;
        history.replaceState(null, "", url);
        window.addEventListener("DOMContentLoaded", () => {
          history.replaceState(null, "", noteHash);
        });
      }
    </script>
  </head>
  <body class={className}>
    <div class="mx-auto max-w-prose px-4 py-10">
      <slot />
    </div>
  </body>
</html>