---
import { type CollectionEntry } from "astro:content";
import TableOfContents from "../components/TableOfContents.tsx";
import { formatDate } from "../lib/utils";
import Layout from "./Layout.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

// Utility to estimate reading time
function estimateReadingTime(text: string, wordsPerMinute = 225) {
  const wordCount = text.trim().split(/\s+/).length;
  const minutes = Math.ceil(wordCount / wordsPerMinute);
  return minutes;
}

const { post } = Astro.props;
const { Content } = await post.render();
const readingTime = estimateReadingTime(post.body ?? "");
const readingHours = Math.floor(readingTime / 60);
const readingMinutes = readingTime % 60;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  className="blog-post-layout"
>
  <div class="blog-post-container mb-32">
    <!-- Main content area -->
    <main>
      <header class="blog-post-header">
        <h1 class="mb-1 flex flex-row gap-4 font-serif text-3xl font-medium">
          {post.data.title}
          {
            post.data.draft && (
              <p class="border-border bg-card text-destructive mt-1.5 mb-1 flex h-min flex-row items-center justify-center gap-2 rounded-full border px-2 align-middle text-base font-semibold">
                {" "}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-eye-off-icon lucide-eye-off"
                >
                  <>
                    <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                    <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                    <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                    <path d="m2 2 20 20" />
                  </>
                </svg>{" "}
                Draft
              </p>
            )
          }
        </h1>
        {
          post.data.description && (
            <p class="text-muted-foreground mb-1 font-medium">
              {post.data.description}
            </p>
          )
        }
        <p
          class="text-muted-foreground mb-8 flex flex-wrap items-center gap-2 font-medium"
        >
          <span>{formatDate(post.data.date)}</span>
          <span class="px-1 font-black">·</span>
          <span
            >~{readingHours ? `${readingHours} hr ` : ""}{readingMinutes} min read</span
          >
          {
            post.body && /\[\^[^\]]+\]:/m.test(post.body) && (
              <button
                type="button"
                id="margin-notes-toggle"
                class="border-border text-muted-foreground hover:bg-accent hover:text-foreground ml-2 inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 text-xs font-medium transition-colors"
                aria-pressed="false"
                aria-label="Toggle margin notes"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-notebook-pen"
                >
                  <path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4" />
                  <path d="M2 6h4" />
                  <path d="M2 10h4" />
                  <path d="M2 14h4" />
                  <path d="M2 18h4" />
                  <path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.78 5.78a2 2 0 0 0-.578 1.236l-1.018 4.058a1 1 0 0 0 1.236 1.236l4.058-1.018a2 2 0 0 0 1.236-.578z" />
                </svg>
                <span id="margin-notes-toggle-label">Margin notes</span>
              </button>
            )
          }
        </p>

        <article class="typeset max-w-none">
          <Content />
        </article>
      </header>

      <!-- Table of Contents Sidebar -->
      <TableOfContents client:load />
    </main>
  </div>

  <style>
    /* Single centred reading column. The table of contents is fixed-position,
       so it sits outside this flow. */
    .blog-post-container {
      position: relative;
      max-width: 40rem;
      margin-inline: auto;
    }

    /* Table of contents sidebar. The component only renders this on wide
       viewports; below that it falls back to the sticky bar. */
    :global(.table-of-contents) {
      position: fixed;
      top: 0;
      right: 1.5rem;
      left: auto;
      width: 260px;
      height: 100vh;
      max-height: 100vh;
      overflow-y: auto;
      z-index: 10;
    }
  </style>
  <script>
    const STORAGE_KEY = "margin-notes-shown";

    function applyMarginNotesState() {
      const shown = localStorage.getItem(STORAGE_KEY) === "true";
      document.body.classList.toggle("margin-notes-shown", shown);

      // Hiding all notes also closes any individually-opened ones.
      if (!shown) {
        document
          .querySelectorAll(".margin-note.open")
          .forEach((note) => note.classList.remove("open"));
      }

      const label = document.getElementById("margin-notes-toggle-label");
      if (label) {
        label.textContent = shown ? "Margin notes on" : "Margin notes";
      }
      const buttons = document.querySelectorAll<HTMLButtonElement>(
        "#margin-notes-toggle",
      );
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", shown ? "true" : "false");
      });
    }

    function setupToggle() {
      document.addEventListener(
        "click",
        (event) => {
          const target = event.target as Element | null;
          const button = target?.closest("#margin-notes-toggle");
          if (button) {
            const currentlyShown =
              document.body.classList.contains("margin-notes-shown");
            localStorage.setItem(STORAGE_KEY, String(!currentlyShown));
            applyMarginNotesState();
            return;
          }
          const noteLink = target?.closest(
            "a[href^='#note-'], a[href^='#ref-']",
          );
          if (noteLink) {
            event.preventDefault();
            const href = noteLink.getAttribute("href");
            const el = href && document.getElementById(href.slice(1));
            if (el) {
              const shown =
                document.body.classList.contains("margin-notes-shown");
              // Collapsed mode: tapping a reference opens/closes its note.
              if (!shown && href.startsWith("#note-")) {
                if (!el.classList.toggle("open")) return;
              }
              el.classList.remove("flash");
              void el.offsetWidth; // force reflow so the animation can restart
              el.classList.add("flash");
            }
          }
        },
        true,
      );
    }

    applyMarginNotesState();
    setupToggle();

    document.addEventListener("astro:page-load", applyMarginNotesState);
  </script>
</Layout>
